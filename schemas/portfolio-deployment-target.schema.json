{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com.au/schemas/portfolio-deployment-target.schema.json",
  "title": "T4H Portfolio Deployment Target",
  "type": "object",
  "required": [
    "target_id",
    "repository",
    "artifact_path",
    "deployment_type",
    "s3_bucket",
    "cloudfront_distribution_id",
    "canonical_url",
    "owner",
    "field_state",
    "status",
    "source_records"
  ],
  "properties": {
    "target_id": {"type": "string", "pattern": "^[a-z0-9-]+-production$"},
    "business_name": {"type": "string"},
    "group": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "artifact_path": {"type": ["string", "null"]},
    "deployment_type": {"type": "string"},
    "dynamic_level": {"type": "string"},
    "risk": {"type": "string"},
    "s3_bucket": {"type": ["string", "null"]},
    "s3_bucket_prefix_proposal": {"type": ["string", "null"]},
    "cloudfront_distribution_id": {"type": ["string", "null"]},
    "canonical_url": {"type": ["string", "null"]},
    "expected_content_identity": {"type": ["object", "null"]},
    "rollback_source": {"type": ["string", "null"]},
    "owner": {"type": "string"},
    "field_state": {
      "type": "object",
      "additionalProperties": {
        "enum": ["OBSERVED", "STALE", "CONFLICTING", "MISSING", "VERIFIED"]
      }
    },
    "status": {"enum": ["REAL", "PARTIAL", "BLOCKED", "ASPIRATIONAL"]},
    "block_reason": {"type": ["string", "null"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "REAL"}}},
      "then": {
        "properties": {
          "repository": {"type": "string"},
          "artifact_path": {"type": "string"},
          "s3_bucket": {"type": "string"},
          "cloudfront_distribution_id": {"type": "string"},
          "canonical_url": {"type": "string"},
          "expected_content_identity": {"type": "object"},
          "rollback_source": {"type": "string"}
        }
      }
    }
  ]
}
