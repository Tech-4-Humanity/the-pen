{
  "fn": "enqueue_job",
  "action": "launch.system.bootstrap",
  "idempotency_key": "launch-system-bootstrap-2026-04-27-001",
  "priority": 1,
  "payload": {
    "version": "1.0",
    "intent": "bootstrap_launch_control_system_for_multi_brand_dev_prod_pullback_relaunch",
    "operating_problem": "T4H is preparing 5-15 URLs, websites and complex brands such as Consent and LifeGraph for near-term launch. Some existing production surfaces need to be pulled back, held, reworked and relaunched. The system must prevent skipped gates, false readiness and paper-only progress.",
    "lanes": [
      {
        "lane": "DEV_TO_PROD",
        "meaning": "New brand/site/app moving live",
        "rule": "Must pass evidence gates before promotion"
      },
      {
        "lane": "PROD_TO_HOLD",
        "meaning": "Live thing pulled back temporarily",
        "rule": "Archive web only; preserve DNS, mail, data and canonical records"
      },
      {
        "lane": "HOLD_TO_DEV",
        "meaning": "Pulled surface returns for rebuild or repositioning",
        "rule": "Treat as a new launch candidate with inherited evidence and rollback history"
      },
      {
        "lane": "PROD_TO_PROD_PLUS",
        "meaning": "Live thing improved without full pullback",
        "rule": "Run smaller release gate but still require runtime proof"
      },
      {
        "lane": "PROD_TO_ARCHIVE",
        "meaning": "Retire from public surface",
        "rule": "HITL gated; never delete first; archive is not delete"
      }
    ],
    "launch_states": [
      "IDEA",
      "DEV",
      "VALIDATING",
      "PROD_READY",
      "LIVE",
      "HOLD",
      "REWORK",
      "ARCHIVED_WEB",
      "RETIRED"
    ],
    "required_tables": [
      {
        "schema": "ops",
        "table": "launch_registry",
        "purpose": "One canonical row per brand/site/product launch candidate",
        "required_columns": [
          "launch_id uuid primary key",
          "brand_key text not null",
          "surface_key text",
          "product_key text",
          "launch_state text not null",
          "lifecycle_state lifecycle_state not null default 'queued'",
          "evidence_status evidence_state not null default 'PARTIAL'",
          "owner text not null",
          "support_owner text",
          "target_launch_at timestamptz",
          "metadata jsonb not null default '{}'::jsonb",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ],
        "constraints": [
          "unique(brand_key, surface_key, product_key)",
          "check launch_state in canonical launch_states"
        ]
      },
      {
        "schema": "ops",
        "table": "surface_inventory",
        "purpose": "All URLs, domains, apps, repos, hosts and DNS relationships",
        "required_columns": [
          "surface_id uuid primary key",
          "surface_key text not null unique",
          "brand_key text not null",
          "url text not null",
          "domain text",
          "dns_zone text",
          "host_provider text",
          "host_project_id text",
          "repo_full_name text",
          "runtime_status text not null default 'UNKNOWN'",
          "last_checked_at timestamptz",
          "metadata jsonb not null default '{}'::jsonb",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ]
      },
      {
        "schema": "ops",
        "table": "asset_binding_map",
        "purpose": "Bind URL/domain/app to repo, host, deployment, owner and evidence",
        "required_columns": [
          "binding_id uuid primary key",
          "surface_id uuid not null references ops.surface_inventory(surface_id)",
          "repo_full_name text",
          "branch text",
          "host_provider text",
          "host_project_id text",
          "deployment_url text",
          "owner text",
          "evidence_id uuid",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ]
      },
      {
        "schema": "ops",
        "table": "launch_dependency_graph",
        "purpose": "Prevent timing collisions and skipped prerequisite launches",
        "required_columns": [
          "edge_id uuid primary key",
          "parent_launch_id uuid not null references ops.launch_registry(launch_id)",
          "child_launch_id uuid not null references ops.launch_registry(launch_id)",
          "dependency_type text not null",
          "blocking boolean not null default true",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ],
        "constraints": [
          "unique(parent_launch_id, child_launch_id, dependency_type)"
        ]
      },
      {
        "schema": "ops",
        "table": "rollback_registry",
        "purpose": "Rollback path for every launch/pullback/relaunch",
        "required_columns": [
          "rollback_id uuid primary key",
          "launch_id uuid not null references ops.launch_registry(launch_id)",
          "rollback_type text not null",
          "rollback_scope text not null",
          "instructions jsonb not null default '{}'::jsonb",
          "verified boolean not null default false",
          "verified_at timestamptz",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ]
      },
      {
        "schema": "ops",
        "table": "gate_results",
        "purpose": "Per-gate PASS/BLOCKED/HOLD/ARCHIVE outcomes",
        "required_columns": [
          "gate_result_id uuid primary key",
          "launch_id uuid not null references ops.launch_registry(launch_id)",
          "gate_name text not null",
          "gate_status text not null",
          "evidence_state evidence_state not null default 'PARTIAL'",
          "evidence_id uuid",
          "rationale text",
          "created_at timestamptz not null default now()",
          "updated_at timestamptz not null default now()"
        ],
        "constraints": [
          "unique(launch_id, gate_name)"
        ]
      },
      {
        "schema": "runtime",
        "table": "lead_probe_runs",
        "purpose": "Synthetic lead/form/CTA runtime proof",
        "required_columns": [
          "probe_id uuid primary key",
          "launch_id uuid references ops.launch_registry(launch_id)",
          "surface_id uuid references ops.surface_inventory(surface_id)",
          "url text not null",
          "probe_type text not null",
          "status text not null",
          "request_payload jsonb not null default '{}'::jsonb",
          "response_payload jsonb not null default '{}'::jsonb",
          "evidence_id uuid",
          "started_at timestamptz not null default now()",
          "finished_at timestamptz",
          "created_at timestamptz not null default now()"
        ]
      },
      {
        "schema": "audit",
        "table": "evidence_register",
        "purpose": "Bind proof to launch gates and runtime outcomes",
        "required_columns": [
          "evidence_id uuid primary key",
          "subject_object_key text not null",
          "evidence_type text not null",
          "evidence_uri text",
          "evidence_payload jsonb not null default '{}'::jsonb",
          "validator text",
          "validation_status evidence_state not null default 'PARTIAL'",
          "created_at timestamptz not null default now()"
        ]
      },
      {
        "schema": "audit",
        "table": "reality_ledger",
        "purpose": "Current REAL/PARTIAL/PRETEND state per launch/surface/gate",
        "required_columns": [
          "subject_object_key text primary key",
          "current_state evidence_state not null",
          "last_evidence_id uuid",
          "rationale text not null",
          "confidence numeric",
          "updated_at timestamptz not null default now()"
        ]
      }
    ],
    "required_jobs": [
      {
        "job": "surface_reconciler",
        "action": "DNS to host to repo match",
        "frequency": "hourly",
        "evidence_required": ["dns_result", "host_project", "repo_binding"]
      },
      {
        "job": "lead_probe",
        "action": "Submit test CTA/lead and verify downstream row/email/CRM receipt",
        "frequency": "per_deploy_and_daily",
        "evidence_required": ["submission_response", "db_row_or_email_receipt"]
      },
      {
        "job": "prod_decay_monitor",
        "action": "Detect stale, broken, unowned or incoherent production surfaces",
        "frequency": "daily",
        "evidence_required": ["http_status", "content_hash", "last_verified_at"]
      },
      {
        "job": "evidence_gate_enforcer",
        "action": "Block promotion without REAL evidence and receipt",
        "frequency": "real_time",
        "evidence_required": ["gate_results", "audit_evidence"]
      },
      {
        "job": "launch_scorer",
        "action": "Calculate launch readiness score",
        "frequency": "on_change",
        "evidence_required": ["score_payload"]
      },
      {
        "job": "receipt_validator",
        "action": "Ensure GitHub receipt and Supabase evidence rows exist",
        "frequency": "real_time",
        "evidence_required": ["github_receipt", "supabase_audit_row"]
      }
    ],
    "readiness_score": {
      "threshold_for_prod": 85,
      "components": [
        { "component": "surface_valid", "weight": 15 },
        { "component": "dns_correct", "weight": 10 },
        { "component": "content_complete", "weight": 10 },
        { "component": "cta_working", "weight": 20 },
        { "component": "lead_path_proven", "weight": 20 },
        { "component": "evidence_attached", "weight": 15 },
        { "component": "rollback_ready", "weight": 10 }
      ],
      "rule": "score_below_85_blocks_prod"
    },
    "gates": [
      "registry_gate",
      "ownership_gate",
      "surface_gate",
      "product_offer_gate",
      "content_gate",
      "runtime_gate",
      "lead_path_gate",
      "evidence_gate",
      "rollback_gate",
      "timing_gate"
    ],
    "anti_false_close_checks": [
      { "risk": "Pretty site with broken form", "check": "Submit real test lead and verify downstream proof" },
      { "risk": "Brand live with no offer", "check": "CTA must produce an action" },
      { "risk": "Domain exists but points to wrong app", "check": "Match DNS to host to repo" },
      { "risk": "Prod stale but not dead", "check": "Move to HOLD, not archive" },
      { "risk": "Launch skipped steps", "check": "Mark PARTIAL until all evidence attached" },
      { "risk": "No owner", "check": "Block promotion" },
      { "risk": "No rollback", "check": "Block promotion" },
      { "risk": "Unknown DNS/mail impact", "check": "Block archive/pullback until mail and DNS preservation verified" }
    ],
    "rules": {
      "require_pk": true,
      "require_timestamps": true,
      "require_rls": true,
      "require_lifecycle_state": true,
      "require_evidence_state": true,
      "block_without_receipt": true,
      "block_partial_promotions": true,
      "enforce_real_evidence": true,
      "archive_not_delete": true,
      "prod_archive_requires_hitl": true,
      "dev_to_pen_no_hitl_required": true
    },
    "expected_receipt": {
      "path": "receipts/runtime/launch-system-bootstrap-2026-04-27-001.receipt.json",
      "must_include": [
        "idempotency_key",
        "commit_sha",
        "execution_status",
        "created_tables_or_skipped_existing",
        "registered_jobs_or_skipped_existing",
        "audit_evidence_id",
        "reality_state"
      ]
    },
    "acceptance": {
      "done_state": "REAL only after GitHub receipt exists and Supabase audit/evidence rows exist",
      "partial_state": "PEN inbox file committed but no runtime receipt yet",
      "pretend_state": "Claimed enqueue with no commit SHA or receipt"
    }
  },
  "meta": {
