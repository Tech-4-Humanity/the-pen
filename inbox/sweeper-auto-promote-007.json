        "promoted_jobs.jsonl",
        "held_for_gate.jsonl",
        "rejected_promotions.jsonl",
        "promotion_summary.md"
      ]
    },
    "definition_of_done": [
      "promotion manifest created or verified",
      "top-ranked candidate jobs evaluated",
      "eligible jobs promoted to PEN with idempotency keys",
