{
  "name": "connector-control-plane-cdk",
  "version": "0.1.0",
  "private": true,
  "bin": { "app": "bin/app.js" },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth --all",
    "diff":  "cdk diff --all",
    "deploy":"cdk deploy --all --require-approval never",
    "destroy":"cdk destroy --all --force",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.21.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
