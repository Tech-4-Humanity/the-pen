{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TML-4PM/the-pen/schema/drain.atom.json",
  "title": "drain.atom",
  "description": "Typed schema for a single drain item in The Pen ecosystem. Enforces status, mode, evidence, and receipt rules per DRAIN_DOCTRINE v1.0.",
  "version": "1.0.0",
  "type": "object",
  "required": ["id", "label", "status", "mode", "importance", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this drain item. Format: drain-<slug>-<timestamp>."
    },
    "label": {
      "type": "string",
      "description": "Human-readable name for this item."
    },
    "status": {
      "type": "string",
      "enum": ["REAL", "PARTIAL", "BLOCKED", "ARCHIVE"],
      "description": "Execution status. PRETEND is not valid."
    },
    "mode": {
      "type": "string",
      "enum": ["KILL", "CHECKPOINT", "HANDOFF", "ARCHIVE", "REGISTER", "LIBRARY"],
      "description": "Operational mode — determines close conditions and validator rules."
    },
    "importance": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "STRATEGIC", "IP"],
      "description": "Priority weight. IP and STRATEGIC items are protected from KILL."
    },
    "evidence": {
      "type": ["object", "null"],
      "description": "Typed proof of execution. Required for REAL status.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["api_response", "database_result", "cli_output", "commit_id", "url", "hash", "reproducible_steps"]
        },
        "value": {
          "type": "string",
          "description": "The actual evidence content — SHA, URL, response body, etc."
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "value"]
    },
    "bridge_id": {
      "type": ["string", "null"],
      "description": "Required for HANDOFF mode. Bridge identifier for the receiving agent."
    },
    "receipt_ref": {
      "type": ["string", "null"],
      "description": "Receipt reference written on HANDOFF completion. Required to promote to ARCHIVE."
    },
    "target_ref": {
      "type": ["string", "null"],
      "description": "External binding reference. Required for REGISTER mode."
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "description": "Human-readable reason for BLOCKED status."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional classification tags."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "closed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Set when status transitions to ARCHIVE."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "REAL" } }, "required": ["status"] },
      "then": { "required": ["evidence"] }
    },
    {
      "if": { "properties": { "mode": { "const": "ARCHIVE" } }, "required": ["mode"] },
      "then": { "required": ["evidence", "receipt_ref"] }
    },
    {
      "if": { "properties": { "mode": { "const": "HANDOFF" } }, "required": ["mode"] },
      "then": { "required": ["bridge_id"] }
    },
    {
      "if": { "properties": { "mode": { "const": "REGISTER" } }, "required": ["mode"] },
      "then": { "required": ["target_ref"] }
    }
  ]
}
