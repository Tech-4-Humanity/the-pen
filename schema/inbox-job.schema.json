{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "T4H Inbox Job",
  "type": "object",
  "required": [
    "fn",
    "action",
    "idempotency_key",
    "payload",
    "priority",
    "meta"
  ],
  "properties": {
    "fn": {
      "type": "string",
      "const": "enqueue_job"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_.]+$",
      "description": "domain.verb format"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-\\d{8}-\\d{3}$",
      "description": "system-action-YYYYMMDD-seq"
    },
    "payload": {
      "type": "object"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "meta": {
      "type": "object",
      "required": [
        "actor",
        "source",
        "ts"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "claude",
            "chatgpt",
            "gemini",
            "troy",
            "worker",
            "cron"
          ]
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}