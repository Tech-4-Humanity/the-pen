    {"id":"cgo","name":"Chief Governance and Legal","default_weight":0.07,"focus":["authority","legal","compliance","ethics"]},
    {"id":"cio","name":"Chief Innovation and Outcomes","default_weight":0.05,"focus":["future value","experimentation","learning","outcomes"]}
