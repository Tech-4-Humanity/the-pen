  "required_dev_actions": [
    "Create product_registry table or queue DDL generation.",
    "Import product family and segment seed records with evidence_state=PARTIAL.",
    "Create product_readiness_gate enum or lookup table.",
    "Create route records for Provider Command Centre, Reality Ledger, AI Sweet Spots, and ConsentX.",
    "Generate first four dev outputs as markdown/json artefacts.",
    "Create evidence_gap_register rows for every missing proof item.",
    "Log receipt_ledger row for each generated output.",
    "Do not classify any product REAL until linked evidence and runtime receipts exist."
  ],
  "bridge_manifest": {
    "idempotency_key": "irf_product_routes_readiness_2026_05_12_v1",
