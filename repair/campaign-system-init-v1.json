{
  "fn": "enqueue_job",
  "action": "campaign.system.init",
  "idempotency_key": "campaign-system-init-v1",
  "payload": {
    "system": "sales_marketing_campaign_engine",
    "version": "1.0",
    "purpose": "Create a gated, skippable, repeatable campaign chain for brand-by-brand 6-12 month sales and marketing promotion.",
    "modules": [
      "product_gate",
      "tech_gate",
      "marketing_builder",
      "content_engine",
      "program_scheduler",
      "distribution",
      "performance_tracking"
    ],
    "agent_roles": [
      {
        "role": "digital_product_manager",
        "owns": [
          "offer_packaging",
          "pricing",
          "icp",
          "market_fit",
          "sku_definition"
        ]
      },
      {
        "role": "tech_readiness_specialist",
        "owns": [
          "deployability",
          "demo",
          "cloud_template",
          "api_or_mock",
          "onboarding",
          "delivery_readiness"
        ]
      },
      {
        "role": "growth_marketing_lead",
        "owns": [
          "campaign_brief",
          "positioning",
          "channels",
          "funnel",
          "message_testing"
        ]
      },
      {
        "role": "program_manager",
        "owns": [
          "sequence",
          "gates",
          "resource_metering",
          "schedule",
          "handoffs"
        ]
      },
      {
        "role": "content_engine",
        "owns": [
          "landing_pages",
          "ads",
          "email",
          "linkedin",
          "case_assets"
        ]
      },
      {
        "role": "distribution_agent",
        "owns": [
          "launch",
          "scheduling",
          "utm",
          "channel_push"
        ]
      },
      {
        "role": "performance_analyst",
        "owns": [
          "metrics",
          "optimisation",
          "stop_scale_decisions",
          "weekly_receipts"
        ]
      }
    ],
    "state_model": [
      "draft",
      "ready_for_gate",
      "approved",
      "blocked",
      "live",
      "optimising",
      "archived"
    ],
    "rules": {
      "skip_allowed": [
        "content.generate"
      ],
      "skip_blocked": [
        "product.validate",
        "tech.validate",
        "marketing.build",
        "program.schedule"
      ],
      "max_primary_campaigns": 1,
      "max_secondary_campaigns": 2,
      "proof_required": true,
      "archive_not_delete": true
    },
    "receipt_contract": {
      "path": "receipts/runtime/<idempotency_key>.json",
      "required_fields": [
        "idempotency_key",
        "status",
        "steps_completed",
        "evidence",
        "timestamp"
      ],
      "no_receipt_means": "not_done"
    }
  },
  "priority": 5,
  "meta": {
    "actor": "chatgpt",
    "source": "chatgpt",
    "handover_to": [
      "Pen",
      "Symbio"
    ],
    "created_at": "2026-04-26T00:00:00+10:00"
  },
  "_repair": {
    "reason": "missing required fields",
    "missing_fields": [
      "origin",
      "destination",
      "topic"
    ],
    "quarantined_at": "2026-04-29T00:12:07Z",
    "source_file": "campaign-system-init-v1.json"
  }
}
