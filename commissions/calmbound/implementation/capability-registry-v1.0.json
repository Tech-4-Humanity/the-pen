{
  "schema_version": "1.0.0",
  "product": "CalmBound",
  "category": "Household Coordination Infrastructure",
  "status": "CANONICAL_IMPLEMENTATION_ARTIFACT",
  "capabilities": [
    {
      "id": "CB-CAP-001",
      "name": "Household Creation",
      "domain": "core",
      "purpose": "Create the primary coordination environment.",
      "actors": ["account_owner"],
      "inputs": ["household_name", "timezone", "owner_identity"],
      "outputs": ["household", "owner_role", "audit_event"],
      "permissions": ["household.create"],
      "events": ["household.created"],
      "telemetry": ["household_creation_started", "household_creation_completed", "household_creation_failed"],
      "dependencies": ["identity", "audit", "evidence"],
      "acceptance": ["owner assigned", "receipt emitted", "readback succeeds"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-002",
      "name": "Household Invitation",
      "domain": "core",
      "purpose": "Invite a person into a household with scoped authority.",
      "actors": ["account_owner", "authorised_adult"],
      "inputs": ["invitee", "role", "scope", "expiry"],
      "outputs": ["invitation", "pending_membership"],
      "permissions": ["household.invite"],
      "events": ["household.invitation_created", "household.invitation_accepted", "household.invitation_expired"],
      "telemetry": ["invitation_created", "invitation_accepted", "invitation_expired"],
      "dependencies": ["identity", "permission_engine", "notification_service"],
      "acceptance": ["scope visible", "expiry enforced", "acceptance receipted"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-003",
      "name": "Kids Visit Mode",
      "domain": "visit",
      "purpose": "Apply a visible household boundary to child visitors on a guest network.",
      "actors": ["authorised_adult", "child_visitor"],
      "inputs": ["household", "guest_network", "visitor_age_band", "guest_policy"],
      "outputs": ["portal_view", "agreement_record", "network_policy_signal"],
      "permissions": ["mode.activate.kids_visit", "guest_policy.apply"],
      "events": ["mode.activated", "agreement.displayed", "agreement.accepted", "network_policy.requested", "network_policy.result"],
      "telemetry": ["portal_rendered", "agreement_response", "policy_apply_result"],
      "dependencies": ["mode_engine", "rule_engine", "permission_engine", "router_adapter", "evidence"],
      "acceptance": ["visitor sees plain-language rule", "no enforcement claimed without router receipt", "agreement event stored"],
      "recovery": ["degraded_mode_banner", "retry_policy_signal", "visible_failure"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-004",
      "name": "Quiet Hours",
      "domain": "home",
      "purpose": "Schedule and apply a household quiet-hours state.",
      "actors": ["authorised_adult", "child", "teen"],
      "inputs": ["schedule", "subjects", "allowed_categories", "override_policy"],
      "outputs": ["mode_instance", "device_policy_signals"],
      "permissions": ["mode.schedule.quiet_hours", "mode.override.request"],
      "events": ["mode.scheduled", "mode.activated", "mode.completed", "override.requested", "override.decided"],
      "telemetry": ["schedule_triggered", "signal_success", "signal_failure", "override_count"],
      "dependencies": ["scheduler", "mode_engine", "device_adapter", "permission_engine"],
      "acceptance": ["schedule is timezone-safe", "child explanation available", "failed device action visible"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-005",
      "name": "Temporary Override",
      "domain": "core",
      "purpose": "Permit a time-bound exception with visible reason and authority.",
      "actors": ["child", "teen", "authorised_adult"],
      "inputs": ["mode_instance", "requester", "reason", "requested_duration"],
      "outputs": ["override_request", "override_decision", "expiry_event"],
      "permissions": ["mode.override.request", "mode.override.approve"],
      "events": ["override.requested", "override.approved", "override.denied", "override.expired"],
      "telemetry": ["override_request_count", "override_approval_rate", "override_expiry_success"],
      "dependencies": ["permission_engine", "scheduler", "notification_service", "evidence"],
      "acceptance": ["reason visible", "authority validated", "expiry enforced", "receipt emitted"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-006",
      "name": "Child-readable Rule View",
      "domain": "trust",
      "purpose": "Explain active household rules in age-appropriate language.",
      "actors": ["child", "teen"],
      "inputs": ["active_mode", "agreements", "age_band"],
      "outputs": ["plain_language_explanation"],
      "permissions": ["rule.view.self"],
      "events": ["rule_explanation.viewed"],
      "telemetry": ["explanation_viewed", "comprehension_feedback"],
      "dependencies": ["mode_engine", "agreement_store"],
      "acceptance": ["start and end visible", "request path visible", "no hidden scoring"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-007",
      "name": "Permission Expiry",
      "domain": "governance",
      "purpose": "Automatically revoke time-limited access.",
      "actors": ["system"],
      "inputs": ["permission", "expiry_time"],
      "outputs": ["revocation", "receipt", "alert_on_failure"],
      "permissions": ["permission.expire"],
      "events": ["permission.expired", "permission.expiry_failed"],
      "telemetry": ["expiry_success_rate", "expiry_latency", "expiry_failure_count"],
      "dependencies": ["scheduler", "permission_engine", "audit"],
      "acceptance": ["revocation verified", "failure quarantined", "receipt persisted"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-008",
      "name": "Consent Receipt",
      "domain": "governance",
      "purpose": "Record purpose-bound consent with scope and expiry.",
      "actors": ["guardian", "adult", "teen_where_applicable"],
      "inputs": ["subject", "grantor", "purpose", "scope", "expiry", "policy_version"],
      "outputs": ["consent_record", "receipt"],
      "permissions": ["consent.grant", "consent.revoke"],
      "events": ["consent.granted", "consent.revoked", "consent.expired"],
      "telemetry": ["consent_grants", "consent_revocations", "consent_expiry_success"],
      "dependencies": ["identity", "permission_engine", "audit"],
      "acceptance": ["purpose explicit", "scope explicit", "revocation available", "receipt immutable"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-009",
      "name": "Subscription Entitlement",
      "domain": "commercial",
      "purpose": "Map billing state to product entitlements without exposing billing data to household behaviour services.",
      "actors": ["system", "account_owner"],
      "inputs": ["subscription_event", "plan"],
      "outputs": ["entitlement_state", "billing_receipt"],
      "permissions": ["billing.entitlement.apply"],
      "events": ["subscription.activated", "subscription.past_due", "subscription.cancelled", "entitlement.changed"],
      "telemetry": ["webhook_processed", "entitlement_reconciled", "billing_error"],
      "dependencies": ["billing_adapter", "event_bus", "audit"],
      "acceptance": ["signed webhook is source of truth", "idempotent processing", "grace period applied"],
      "lifecycle": "phase_1"
    },
    {
      "id": "CB-CAP-010",
      "name": "Data Export and Deletion",
      "domain": "governance",
      "purpose": "Provide verifiable export and deletion lifecycle actions.",
      "actors": ["data_owner", "lawful_guardian"],
      "inputs": ["subject", "scope", "request_type"],
      "outputs": ["export_package_or_deletion_result", "receipt"],
      "permissions": ["data.export", "data.delete"],
      "events": ["data.export_requested", "data.export_completed", "data.deletion_requested", "data.deletion_completed", "data.deletion_failed"],
      "telemetry": ["export_latency", "deletion_latency", "deletion_failure_count"],
      "dependencies": ["data_governance", "audit", "recovery_service"],
      "acceptance": ["identity verified", "scope resolved", "completion read back", "failure not silent"],
      "lifecycle": "phase_1"
    }
  ]
}
