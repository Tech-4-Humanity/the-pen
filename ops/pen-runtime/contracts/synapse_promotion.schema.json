{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SynapsePromotion",
  "type": "object",
  "required": ["task_id", "evidence", "promoted_at"],
  "properties": {
    "task_id": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" },
          "commit_sha": { "type": "string" }
        }
      }
    },
    "bridge_receipt_id": { "type": "string" },
    "source_sha": { "type": "string" },
    "bridge_sha": { "type": "string" },
    "promoted_at": { "type": "string", "format": "date-time" },
    "promoted_by": { "type": "string" }
  }
}
