{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T4H Asset Registry Item",
  "type": "object",
  "required": [
    "asset_name",
    "asset_type",
    "source",
    "reuse_candidates",
    "evidence_strength",
    "confidence",
    "next_action"
  ],
  "properties": {
    "asset_name": {"type": "string"},
    "asset_type": {"type": "string", "enum": ["data", "workflow", "component", "capability", "model", "prompt", "report", "dashboard", "integration", "policy", "playbook", "schema", "contract", "visual", "website", "other"]},
    "source": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "source_object_type": {"type": "string"},
    "related_capabilities": {"type": "array", "items": {"type": "string"}},
    "related_components": {"type": "array", "items": {"type": "string"}},
    "reuse_candidates": {"type": "array", "items": {"type": "string"}},
    "reuse_count": {"type": "integer", "minimum": 0},
    "customer_segments": {"type": "array", "items": {"type": "string"}},
    "markets": {"type": "array", "items": {"type": "string"}},
    "revenue_paths": {"type": "array", "items": {"type": "string"}},
    "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "reuse_potential": {"type": "number", "minimum": 0, "maximum": 1},
    "revenue_potential": {"type": "number", "minimum": 0, "maximum": 1},
    "execution_readiness": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "graph_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "edge", "to"],
        "properties": {
          "from": {"type": "string"},
          "edge": {"type": "string"},
          "to": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["REAL", "PARTIAL", "BLOCKED", "UNKNOWN"]},
    "next_action": {"type": "string"}
  }
}
