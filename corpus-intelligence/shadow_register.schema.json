{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T4H Shadow Register",
  "type": "object",
  "required": [
    "shadow_signal",
    "why_it_matters",
    "source",
    "frequency",
    "potential_value",
    "recommended_state",
    "next_action",
    "evidence_strength",
    "confidence"
  ],
  "properties": {
    "shadow_signal": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "source": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "frequency": {"type": "integer", "minimum": 1},
    "first_seen": {"type": "string"},
    "last_seen": {"type": "string"},
    "potential_value": {"type": "string", "enum": ["low", "medium", "high", "very_high", "unknown"]},
    "evidence_strength": {"type": "number", "minimum": 0, "maximum": 1},
    "reuse_potential": {"type": "number", "minimum": 0, "maximum": 1},
    "revenue_potential": {"type": "number", "minimum": 0, "maximum": 1},
    "execution_readiness": {"type": "number", "minimum": 0, "maximum": 1},
    "related_assets": {"type": "array", "items": {"type": "string"}},
    "related_capabilities": {"type": "array", "items": {"type": "string"}},
    "possible_products": {"type": "array", "items": {"type": "string"}},
    "possible_markets": {"type": "array", "items": {"type": "string"}},
    "possible_customer_segments": {"type": "array", "items": {"type": "string"}},
    "possible_revenue_paths": {"type": "array", "items": {"type": "string"}},
    "recommended_state": {"type": "string", "enum": ["discovered", "active", "incubating", "validated", "reusable", "recomposable", "blocked", "parked", "deprecated", "superseded", "merged", "dead"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "next_action": {"type": "string"},
    "authority_boundary": {"type": "string", "enum": ["none", "credential", "secret", "external_authority", "legal_acceptance", "money_movement", "irreversible_commitment"]},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
