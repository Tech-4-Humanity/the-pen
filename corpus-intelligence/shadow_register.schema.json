{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T4H Shadow Register",
  "type": "object",
  "required": ["shadow_signal", "source", "frequency", "potential_value", "recommended_state", "next_action"],
  "properties": {
    "shadow_signal": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "source": {"type": "string"},
    "frequency": {"type": "integer", "minimum": 1},
    "potential_value": {"type": "string", "enum": ["low", "medium", "high", "very_high", "unknown"]},
    "related_assets": {"type": "array", "items": {"type": "string"}},
    "possible_products": {"type": "array", "items": {"type": "string"}},
    "possible_markets": {"type": "array", "items": {"type": "string"}},
    "recommended_state": {"type": "string", "enum": ["active", "incubating", "parked", "dead"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "next_action": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
